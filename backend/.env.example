# Copy to .env and fill in. The .env file is gitignored.

# Anthropic API key (required for the bot agent and insights narration).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the agent. Default: Claude Sonnet 4.6.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Allowed frontend origin for CORS (the Next.js dev server).
FRONTEND_ORIGIN=http://localhost:3000

# --- Supabase (arquitectura v2: datos + auth + persistencia de chats) ---
SUPABASE_PROJECT_URL=https://sampleproject.supabase.co
SUPABASE_PUBLIC_KEY=samplepublickey            # anon/publishable key (segura en cliente)
SUPABASE_SERVICE_ROLE_KEY=sampleservicekey     # SOLO backend, jamás exponer
SUPABASE_DATABASE_PASSWORD=samplepassword
# Conexión Postgres directa (session pooler). scripts/apply_migrations.py y el snapshot la usan.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# Password de los 3 usuarios demo (scripts/seed_users.py): juan/mariana/daniel@saior.demo
DEMO_USERS_PASSWORD=changeme

# Nivel 2 del motor (SQL generado por el agente con guardrails). false = solo tools tipados.
RUN_SQL_ENABLED=true